# PostgreSQL connection string (Neon / Supabase / local). Use the pooled URL on serverless.
DATABASE_URL=postgres://user:password@host:5432/tvr_task_tracking?sslmode=require

# Token from @BotFather. Server-side only - never prefix with NEXT_PUBLIC_.
BOT_TOKEN=123456789:replace-with-botfather-token

# The only Telegram user ID that may use the app (get it from @userinfobot).
ALLOWED_TELEGRAM_USER_ID=123456789

# Random string sent by Telegram in X-Telegram-Bot-Api-Secret-Token on webhook calls (A-Z a-z 0-9 _ -, 1-256 chars).
WEBHOOK_SECRET=replace-with-long-random-string

# Public https URL of the deployed app (no trailing slash). Use your tunnel URL for local testing.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Bearer secret for /api/cron/* (Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=replace-with-another-long-random-string

# Optional: HS256 key for web-admin login JWTs (min 32 chars, e.g. `openssl rand -hex 32`).
# Unset = a key derived from BOT_TOKEN. Changing it logs out every browser and invalidates issued tokens.
# JWT_SECRET=

# Optional: custom Bot API server root (defaults to https://api.telegram.org). Leave unset in normal use.
# TELEGRAM_API_ROOT=

# Optional: sync the daily task list to Google Sheets (see README). Set all three to enable.
# Service account JSON -> client_email and private_key (keep the \n escapes, wrap in quotes). Share the Sheet with that email as Editor.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=tvr-sync@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=the-id-from-the-sheet-url
# GOOGLE_SHEET_TAB=Daily Tasks
